# ---- Required -----------------------------------------------------------------
NODE_ENV=development
PORT=5000
# MongoDB Atlas (replica set; required for multi-document transactions)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/futuretech?retryWrites=true&w=majority
# Unique random secrets (>= 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# 32 bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
# Used in emailed links (password reset, invitations, estimate links)
APP_BASE_URL=http://localhost:3000

# ---- Optional -------------------------------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
SESSION_MAX_AGE_DAYS=30
TRUST_PROXY_HOPS=1
DEFAULT_TIMEZONE=America/New_York
# Background jobs: in-process worker (true for single-server deployments) or
# run `npm run worker` separately. On serverless, call POST /api/v1/internal/jobs/run
# on a schedule with "Authorization: Bearer $CRON_SECRET".
RUN_WORKER_IN_PROCESS=true
CRON_SECRET=

# Evidence storage: gridfs (MongoDB, default) or local
STORAGE_DRIVER=gridfs
STORAGE_LOCAL_DIR=uploads
MAX_UPLOAD_BYTES=26214400

# Online card payments (Stripe). Leave empty to use in-store payments only.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# SMS (Twilio) and email (SendGrid). Leave empty to disable outbound delivery.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
EMAIL_FROM=

# AutoMind diagnostic gateway. Leave empty for manual diagnostic entry only.
AUTOMIND_GATEWAY_URL=
AUTOMIND_API_KEY=
AUTOMIND_INGEST_SECRET=

# Licensed technical-data provider bridge (OEM / aggregator). Optional.
TECHDATA_PROVIDER_NAME=
TECHDATA_PROVIDER_URL=
TECHDATA_API_KEY=

# AI is disabled in this release (planned provider: OpenAI).
AI_PROVIDER=none

# First admin (npm run create-admin)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
